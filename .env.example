# Exemple de variables d'environnement (ne jamais mettre de vraies valeurs ici).

# --- Publicités Meta (Facebook + Instagram) ---
# Jeton d'utilisateur système (permission ads_read)
META_ACCESS_TOKEN=
# ID du compte publicitaire (avec ou sans le préfixe act_)
META_AD_ACCOUNT_ID=
# ID du Pixel Meta (public, côté navigateur)
NEXT_PUBLIC_META_PIXEL_ID=

# --- Google Ads ---
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# ID du client, sans tirets
GOOGLE_ADS_CUSTOMER_ID=
# Optionnel : ID du compte gestionnaire (MCC), sans tirets
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# ID de balise de suivi (AW-XXXXXXXXX) et libellé de conversion « prospect »
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=

# --- eBay (ventes, frais, boutique) : voir docs/EBAY-SETUP.md ---
# App ID (Client ID) du jeu de clés Production
EBAY_APP_ID=
# Cert ID (Client Secret) du même jeu de clés
EBAY_CERT_ID=
# Refresh token OAuth du compte vendeur (droits sell.fulfillment + sell.finances)
EBAY_REFRESH_TOKEN=
# Facultatif : place de marché (EBAY_CA par défaut)
EBAY_MARKETPLACE_ID=

# --- Serveur ---
# Secret pour les appels cron (Authorization: Bearer ...)
CRON_SECRET=
# Clé service Supabase (serveur seulement, jamais dans .env.production)
SUPABASE_SERVICE_ROLE_KEY=
# URL publique du site (ex. https://technolot.ca) : contrôle d'origine des requêtes admin (CSRF) ;
# la variante www est acceptée aussi. Sur Vercel Preview, mettre l'URL de la prévisualisation.
SITE_URL=
# 32 octets aléatoires ou plus, serveur seulement : Hostinger, Vercel Preview, .env.local ;
# son empreinte SHA-256 est dans securite.secret_rpc. Jamais NEXT_PUBLIC_.
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SECURITE_RPC_SECRET=

# --- Mail API de Hostinger (« Voir le courriel » des soumissions) ---
# Clé Agentic Mail → API access, limitée à la boîte info@ (Hostinger n'offre pas de clé en lecture seule) ; serveur seulement, jamais NEXT_PUBLIC_ ni Vercel
HOSTINGER_MAIL_API_TOKEN=
# Facultatif : adresse de la boîte à lire (CONTACT_EMAIL, sinon info@technolot.ca, par défaut)
HOSTINGER_MAIL_ADRESSE=
# Facultatif : resourceId de la boîte (AC…), évite l'appel à /api/v1/me
HOSTINGER_MAIL_MAILBOX_ID=

# Connexion admin : noms d'utilisateur supplémentaires → courriel Supabase (« info » → info@technolot.ca est déjà inclus)
ADMIN_USERNAMES=
# Exigé par eBay pour activer le keyset Production (32-80 caractères au choix)
EBAY_VERIFICATION_TOKEN=
# L'URL exacte déclarée dans le portail eBay
EBAY_DELETION_ENDPOINT=https://technolot.ca/api/ebay/account-deletion
