# Exemple de variables d'environnement : NOMS seulement, jamais de vraies valeurs ici.
# Copier en .env.local (ignoré par Git) pour le développement. En production, chaque
# variable se règle chez l'hébergeur (Hostinger) ; sur la préversion, dans Vercel (Preview).
# Règle : seules les variables NEXT_PUBLIC_ sont envoyées au navigateur ; aucun secret
# ne doit porter ce préfixe. Au démarrage, lib/securite/env.ts signale les manquantes.

# --- Supabase ---
# URL du projet et clé publishable (publiques, intégrées au build ; la RLS protège la base)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clé secrète (contourne la RLS) : serveur seulement, pour les tâches planifiées.
# Hostinger seulement ; jamais dans .env.production ni sur Vercel.
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin ---
# Courriels autorisés à entrer dans /admin (séparés par des virgules) ; à garder
# alignés sur la table public.admins de la base.
ADMIN_EMAILS=
# Facultatif : noms d'utilisateur de connexion → courriel (« info » → info@technolot.ca est déjà inclus)
# Format : nom:courriel,nom2:courriel2
ADMIN_USERNAMES=

# --- Sécurité (serveur seulement) ---
# URL publique du site (forme canonique, ex. https://www.technolot.ca ; la variante sans www
# est acceptée) : contrôle d'origine des requêtes admin (CSRF), liens de connexion.
# Sur Vercel Preview, mettre l'URL de la prévisualisation. Sans elle, les POST admin répondent 503.
SITE_URL=
# 32 octets aléatoires ou plus : Hostinger, Vercel Preview, .env.local ; son empreinte
# SHA-256 est dans securite.secret_rpc. Écritures publiques, journal et limites de débit.
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SECURITE_RPC_SECRET=
# Bearer des tâches planifiées du site (/api/cron/sync, ads-sync, ebay-sync, auto-relances),
# 32 caractères ou plus ; différent du CRON_SECRET des fonctions Edge.
CRON_SECRET=

# --- Courriels sortants (Resend) ---
RESEND_API_KEY=
# Destinataire des soumissions et des alertes de sécurité
CONTACT_EMAIL=
# Expéditeur (adresse du domaine vérifié chez Resend)
FROM_EMAIL=

# --- Mail API de Hostinger (« Voir le courriel » des soumissions) ---
# Clé Agentic Mail → API access, limitée à la boîte info@ (Hostinger n'offre pas de clé
# en lecture seule) ; serveur seulement, jamais NEXT_PUBLIC_ ni Vercel
HOSTINGER_MAIL_API_TOKEN=
# Facultatif : adresse de la boîte à lire (CONTACT_EMAIL, sinon info@technolot.ca, par défaut)
HOSTINGER_MAIL_ADRESSE=
# Facultatif : resourceId de la boîte (AC…), évite l'appel à /api/v1/me
HOSTINGER_MAIL_MAILBOX_ID=

# --- IA (Anthropic) : « analyser un courriel » et import d'annonce eBay de l'admin ---
ANTHROPIC_API_KEY=

# --- eBay (ventes, frais, boutique) : voir docs/EBAY-SETUP.md ---
# App ID (Client ID) du jeu de clés Production
EBAY_APP_ID=
# Cert ID (Client Secret) du même jeu de clés
EBAY_CERT_ID=
# Refresh token OAuth du compte vendeur (droits sell.fulfillment + sell.finances).
# Dans .env.local, entre guillemets doubles s'il contient « # ».
EBAY_REFRESH_TOKEN=
# Facultatif : place de marché (EBAY_CA par défaut)
EBAY_MARKETPLACE_ID=
# Exigé par eBay pour activer le keyset Production (32-80 caractères au choix)
EBAY_VERIFICATION_TOKEN=
# L'URL exacte déclarée dans le portail eBay (ex. https://technolot.ca/api/ebay/account-deletion)
EBAY_DELETION_ENDPOINT=

# --- Publicités Meta (Facebook + Instagram) ---
# Jeton d'utilisateur système (permission ads_read)
META_ACCESS_TOKEN=
# ID du compte publicitaire (avec ou sans le préfixe act_)
META_AD_ACCOUNT_ID=
# ID du Pixel Meta (public, côté navigateur)
NEXT_PUBLIC_META_PIXEL_ID=

# --- Google Ads ---
# Méthode recommandée : clé JSON du compte de service (sur une ligne)
GOOGLE_ADS_SERVICE_ACCOUNT_JSON=
# Ancienne méthode (repli) : client OAuth + refresh token + developer token
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# ID du client, sans tirets
GOOGLE_ADS_CUSTOMER_ID=
# Optionnel : ID du compte gestionnaire (MCC), sans tirets
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# ID de balise de suivi (AW-XXXXXXXXX) et libellé de conversion « prospect » (publics)
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=

# --- Mesure et vérification (publics) ---
# Google Analytics 4 (G-XXXXXXX)
NEXT_PUBLIC_GA4_ID=
# Balise de vérification Google Search Console
NEXT_PUBLIC_GSC_VERIFICATION=

# --- Ne pas définir ici ---
# Fournies par l'hébergeur ou par Next : NODE_ENV, PORT, NEXT_RUNTIME, VERCEL, VERCEL_ENV,
# VERCEL_URL, VERCEL_BRANCH_URL.
# Secrets des fonctions Edge (Supabase → Edge Functions → Secrets, jamais dans ce fichier) :
# CRON_SECRET (valeur distincte de celle du site, aussi dans le Vault « cron_secret_edge »),
# IMAP_HOST, IMAP_PORT, IMAP_USER, IMAP_PASS, ANTHROPIC_API_KEY ; SUPABASE_URL et
# SUPABASE_SERVICE_ROLE_KEY y sont injectées par Supabase.
