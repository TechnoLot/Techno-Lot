<?xml version="1.0" encoding="utf-8"?>
<!--
  Narration de la pub 30 s « Le voyage d'un disque dur ».
  Document SSML Azure standard : avec une clé Azure Speech, il peut être envoyé tel quel.
  Sans clé, tools/voice.py le lit et l'exécute phrase par phrase (le point d'accès
  gratuit refuse les <break>) : chaque <s> est synthétisée seule, chaque <break>
  devient un silence exact. Les pauses sont réglées pour que chaque réplique tombe
  sur son plan (voir README).
-->
<speak version="1.0" xmlns="http://www.w3.org/2001/10/synthesis" xml:lang="fr-CA">
  <voice name="fr-CA-ThierryNeural">
    <break time="300ms"/>
    <prosody rate="+6%">
      <s id="placard">Vos vieux ordis traînent dans un placard?</s>
    </prosody>
    <break time="150ms"/>
    <prosody rate="+4%">
      <s id="valent">Ils valent encore de l'argent.</s>
    </prosody>
    <break time="900ms"/>
    <prosody rate="+2%">
      <s id="rachete">Chez Techno Lot, on rachète vos lots informatiques :</s>
    </prosody>
    <break time="150ms"/>
    <prosody rate="-2%">
      <s id="liste">portables, tours, serveurs, écrans.</s>
    </prosody>
    <break time="490ms"/>
    <prosody rate="+0%">
      <s id="evaluation">Évaluation gratuite,</s>
    </prosody>
    <break time="620ms"/>
    <prosody rate="+0%">
      <s id="offre">offre rapide,</s>
    </prosody>
    <break time="780ms"/>
    <prosody rate="+0%">
      <s id="cueillette">cueillette partout au Québec.</s>
    </prosody>
    <!-- Pause avant « Et vos données? » : le disque tourne, presque silence -->
    <break time="1490ms"/>
    <prosody rate="-4%">
      <s id="donnees">Et vos données?</s>
    </prosody>
    <break time="2320ms"/>
    <prosody rate="+0%">
      <s id="detruit">On les détruit gratuitement, de façon sécurisée.</s>
    </prosody>
    <break time="1090ms"/>
    <prosody rate="+0%">
      <s id="paiement">Paiement rapide et garanti.</s>
    </prosody>
    <!-- Pause avant le slogan final -->
    <break time="1300ms"/>
    <prosody rate="+0%">
      <s id="slogan">Techno Lot point C A, on s'occupe de tout.</s>
    </prosody>
  </voice>
</speak>
